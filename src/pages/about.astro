---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Mike Cirrotti" description="About Mike Cirrotti — AI Product leader at the intersection of insurance, analytics, and generative AI.">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about me and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.png"
					alt="Mike Cirrotti at work"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I work at the intersection of insurance, analytics, and artificial intelligence —
						thoughtfully exploring, experimenting, and scaling generative and agentic AI capabilities
						into the underwriting process to achieve a more efficient experience, more effective
						outcomes, and more empowered Underwriters.
					</p>
					<p>
						In 2025, I led a multi-national, multi-disciplinary team spanning Engineering, Data Science,
						UX, and Insurance subject matter experts — tasked with rapidly prototyping agentic AI
						capabilities as part of a CIO initiative to evaluate technology feasibility and readiness.
						We presented our findings directly to the CEO to help shape the vision for transformative
						AI use at Liberty Mutual.
					</p>
					<p>
						Prior to that, my team and I recovered $25M in premium leakage over two years, helping
						reduce what would otherwise be higher rate increases for customers. I have a track record
						of leading people, projects, and processes to define strategy, drive change, and deliver
						measurable impact — including developing analytical talent and partnering with non-technical
						audiences to apply AI, predictive models, experimental design, and systems thinking to
						high-priority business problems.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>MBA</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>Generative AI · Agentic AI · AI Product Management · Analytics · Predictive Modeling · Experimental Design · Systems Thinking · Strategy · Innovation · People Leadership · Cross-functional Collaboration · Insurance & Underwriting</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
