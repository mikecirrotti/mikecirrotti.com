---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity } from '../lib/identity';

// About-page hero image. Deliberately absent — do not restore from
// public/assets/at-work.{jpg,png}. Those are leftover Astro-template stock
// photos of people who aren't Mike, so they can't ship under this alt text.
// Point this at a real photograph to bring the image back.
const aboutHeroImage: string | null = null;
---

<BaseLayout title="About | Mike Cirrotti" description={`${identity.name} — ${identity.oneLine}`}>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Business judgment, technical fluency, and leading across disciplines."
			>
				{aboutHeroImage && (
					<img
						width="1553"
						height="873"
						src={aboutHeroImage}
						alt="Mike Cirrotti at work"
					/>
				)}
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p class="standfirst"><em>I lead multidisciplinary project teams from business problem to practical data and AI solutions.</em></p>
					<p>
						My work brings together strategic, analytical, and technical perspectives. I help people agree on the problem, what a useful solution needs to deliver, and how to test it.
					</p>
					<p>
						Today I work in an innovation lab at a Fortune 100 property and casualty insurer, focusing on generative and agentic AI across the insurance value chain. I identify opportunities, shape solution approaches, and partner with engineering and data science to move capabilities from exploration into production. I'm not an engineer; I bring hands-on prototyping into the work to test assumptions and make ideas concrete.
					</p>
					<p>
						My background is in economic consulting and insurance analytics. I began by using econometric models to investigate complex questions and explain findings to legal audiences. Later, I led a multidisciplinary team of analysts and project managers focused on underwriting data accuracy. That team's work recovered eight figures in premium leakage over two years, reducing what would otherwise have been higher rate increases for customers.
					</p>
					<p>
						Developing people's judgment and giving them ownership have been central to how I lead. As AI makes it possible to contribute across traditional role boundaries, I'm interested in how teams use that flexibility while continuing to draw on the depth of their different disciplines.
					</p>
					<p>
						I also bring outside perspectives and emerging research into practical work. That has included proposing automated experiments to refine an agent's instructions and tools against an evaluation standard.
					</p>
					<p class="closing">My job description has never been the ceiling to what's worth doing.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">What I Bring</h2>
				<div class="content pillars">
					<h3>Problem Shape Recognition</h3>
					<p>
						The ability to sense which business problems are genuinely suited to AI solutions — and which aren't. This is harder than it sounds and more valuable than execution. Before you can build the right thing, someone has to ask the right question.
					</p>
					<h3>Full-Register Fluency</h3>
					<p>
						Equally comfortable in the strategic big picture with non-technical stakeholders and in the technical weeds with engineers. Not many people can move between those registers in the same conversation. I've built that range deliberately.
					</p>
					<h3>Deliberate Adjacency</h3>
					<p>
						At every stage, I've invested in the layer that wasn't required. As an analyst: data science fluency and domain depth. In my current role: firsthand AI prototyping without an engineering title. My job description has never been the ceiling to what's worth doing.
					</p>
					<h3>Domain-Grounded AI Literacy</h3>
					<p>
						Ten years in data analytics, now applied to LLMs and agentic systems. Not engineering — but genuine, firsthand familiarity with how these systems work, where they fail, and how to direct them toward problems worth solving.
					</p>
					<h3>End User Empathy</h3>
					<p>
						A practiced instinct for imagining the person on the other end of the work. In an era when it's easy to optimize for what's technically impressive, this is what keeps the human in focus. It's what made the analytics translator identity work, and it's what makes the AI work worth doing.
					</p>
					<h3>High-Agency Orientation</h3>
					<p>
						A bias toward building, shipping, and learning rather than waiting for structures to carry the work forward. The future belongs to people who combine domain depth with the agency to act on it. That's the combination I'm building toward.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Career Arc</h2>
				<div class="content">
					<ol class="arc">
						<li class="arc-item">
							<p class="arc-date">2014–2016</p>
							<h3>Economic Consulting</h3>
							<p>Used econometrics to investigate complex questions across industries and explain findings to legal audiences.</p>
						</li>
						<li class="arc-item">
							<p class="arc-date">2016–2025</p>
							<h3>Data Analytics → Team Leadership</h3>
							<p>Advanced through insurance analytics into leading analysts and project managers. Set direction for underwriting data accuracy work, developed analytical talent, and partnered across business and technical disciplines.</p>
						</li>
						<li class="arc-item">
							<p class="arc-date">2025–Present</p>
							<h3>AI Product Strategy &amp; Delivery</h3>
							<p>Work in an innovation lab on generative and agentic AI across the insurance value chain. Lead multidisciplinary project teams and drive capabilities from exploration through evaluation into production, in partnership with engineering and data science.</p>
						</li>
					</ol>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
						<p>I hold an MBA from Boston University's Questrom School of Business and a BA in Quantitative Economics from Providence College, with a finance minor.</p>
						<p class="education-additional">Additional study includes General Assembly's Data Science program (2017) and a Statistical Methods course at Harvard Extension School (spring 2015).</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.standfirst {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.standfirst {
			font-size: var(--text-xl);
		}
	}

	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		/* Below 50em the section label sits directly above the first pillar
		   heading with nothing but this gap to separate two similar-sized
		   headings, so it needs more than the 0.5rem the rest of the site uses.
		   Irrelevant at 50em+, where sections become `display: contents`. */
		gap: 1.5rem;
		color: var(--gray-200);
	}

	.section-title {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	/* Below 50em the prose runs the full container, which reaches ~90 characters
	   at tablet widths. The grid caps the measure above the breakpoint; this
	   caps it below. */
	.content {
		max-width: 36rem;
	}

	/* global.css resets every margin to 0 and nothing restores paragraph rhythm,
	   so without this the whole page renders as one unbroken block of type.
	   `em` keeps the spacing tied to the reading size, which grows at 50em. */
	.content > * + * {
		margin-block-start: 1.25em;
	}

	.content > * + .closing {
		margin-block-start: 2rem;
	}

	.closing {
		font-size: var(--text-xl);
		font-style: italic;
		color: var(--gray-0);
	}

	/* h3 in global.css clamps up to 2.625rem, which would dwarf the body copy
	   these headings sit above. */
	.content h3 {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.pillars > * + h3 {
		margin-block-start: 2rem;
		padding-block-start: 2rem;
		border-block-start: 1px solid var(--gray-800);
	}

	/* ====================================================== */

	.arc {
		list-style: none;
		padding: 0;
	}

	.arc-item {
		position: relative;
		padding-inline-start: 1.75rem;
		padding-block-end: 2.5rem;
		border-inline-start: 1px solid var(--gray-800);
	}

	/* Terminate the rail at the final marker rather than running past it.
	   Transparent, not `none`, so the text stays aligned with the items above. */
	.arc-item:last-child {
		border-inline-start-color: transparent;
		padding-block-end: 0;
	}

	.arc-item::before {
		content: '';
		position: absolute;
		/* Centres the 9px marker on the 1px rail. */
		inset-inline-start: -4px;
		top: 0.45em;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent-regular);
	}

	.arc-date {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		/* --accent-regular is too dark to read on the dark theme's background;
		   --link-color is the accent token that's tuned for both themes. */
		color: var(--link-color);
	}

	.arc-item h3 {
		margin-block-start: 0.25rem;
	}

	.arc-item h3 + p {
		margin-block-start: 0.5rem;
	}


	.education-additional {
		margin-block-start: 1em;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	/* ====================================================== */

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			/* Section label | prose. Capping the prose column at 40rem holds the
			   measure near 65ch; it ran to ~106ch when the content spanned two
			   columns of a `1fr 60% 1fr` grid. Centred with justify-content rather
			   than by adding empty gutter tracks — those would contribute their own
			   column gaps and steal ~80px from the prose at tablet widths. */
			grid-template-columns: minmax(6rem, 13rem) minmax(0, 40rem);
			justify-content: center;
			column-gap: 2.5rem;
			align-items: start;
		}

		/* Hero spans both columns so it stays centred on the page. */
		.about > :global(:first-child) {
			grid-column: 1 / -1;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}

		.section-title {
			grid-column: 1 / 2;
		}

		.content {
			grid-column: 2 / 3;
			/* The prose column already caps the measure here. */
			max-width: none;
		}
	}
</style>
