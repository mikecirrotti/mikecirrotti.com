---
import { Content } from '../../../docs/drafts/the-harness.md';
import MainHead from '../../components/MainHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="en">
  <head>
    <MainHead title="The Harness — Draft Preview" description="A personal learning experiment with AI-generated audio." />
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </head>
  <body>
    <Nav />
    <main class="wrapper">
      <div class="preview-note">Draft preview · Audio excerpts not yet added</div>
      <article class="content"><Content /></article>
    </main>
    <Footer />
  </body>
</html>
<style>
  main { padding-block: 1rem 5rem; }
  .preview-note, .content { max-width: 65ch; margin-inline: auto; }
  .preview-note { margin-bottom: 2rem; border: 1px solid var(--gray-700); border-radius: .5rem; padding: .75rem 1rem; font-size: var(--text-sm); color: var(--gray-300); }
  .content { font-size: var(--text-md); line-height: 1.7; overflow-wrap: break-word; }
  .content :global(h1) { font-size: clamp(2.6rem, 7vw, 4.5rem); margin-bottom: 1rem; }
  .content :global(h2) { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 3rem 0 1.25rem; }
  .content :global(h3) { font-size: clamp(1.25rem, 3vw, 1.6rem); margin: 2rem 0 .75rem; }
  .content :global(p + p) { margin-top: 1.1rem; }
  .content :global(h1 + p) { font-size: var(--text-lg); margin-bottom: 2rem; }
  .content :global(p:has(> em:only-child)) { color: var(--gray-400); font-size: var(--text-base); }
  .content :global(a) { text-underline-offset: .2em; }
  @media (max-width: 30em) { .content { font-size: var(--text-base); } }
</style>
