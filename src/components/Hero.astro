---
interface Props {
	title: string;
	subtitle?: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title, subtitle } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h1 class="title">{title}</h1>
		{subtitle && <p class="subtitle">{subtitle}</p>}
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline,
	.subtitle {
		max-width: 37ch;
		margin-inline: auto;
	}

	.subtitle {
		font-style: italic;
		color: var(--accent-regular);
	}

	.title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline,
		.start .subtitle {
			margin-inline: unset;
		}

		.title {
			font-size: var(--text-5xl);
		}
	}
</style>
